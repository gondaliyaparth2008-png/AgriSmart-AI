# AgriSmart AI — Environment Configuration Template
APP_NAME="AgriSmart AI"
APP_VERSION="1.0.0"
DEBUG=true

# Database (Default local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./agrismart.db

# Supabase (Optional)
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ML Model (Leave empty for mock engine)
MODEL_PATH=models/crop_disease_model.onnx
MODEL_INPUT_SIZE=224
CONFIDENCE_THRESHOLD=0.45

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5