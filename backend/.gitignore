# ─────────────────────────────────────────────────────────────────────────────
#  AgriSmart AI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets / Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Local databases ───────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── ML model weights (large binaries) ────────────────────────────────────────
models/*.onnx
models/*.pt
models/*.pth
models/*.h5
models/*.pkl

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
